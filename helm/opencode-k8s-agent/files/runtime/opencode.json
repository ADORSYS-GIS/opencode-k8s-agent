{
  "logLevel": "DEBUG",
  "plugin": ["@vymalo/opencode-oauth2"],
  "provider": {
    "lightbridge": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${OPENCODE_BASE_URL}",
        "oauth2": {
          "issuer": "${OAUTH2_ISSUER}",
          "clientId": "${OAUTH2_CLIENT_ID}",
          "clientSecret": "${OAUTH2_CLIENT_SECRET}",
          "scopes": ["openid"],
          "authFlow": "client_credentials"
        }
      },
      "models": {
        "${OPENCODE_MODEL}": {
          "id": "${OPENCODE_MODEL}",
          "tool_call": true
        }
      }
    }
  },
  "agent": {
    "coder": {
      "model": "lightbridge:${OPENCODE_MODEL}"
    }
  },
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": [
        "/usr/local/bin/kubernetes-mcp-server"
      ],
      "enabled": true
    }
  }
}
