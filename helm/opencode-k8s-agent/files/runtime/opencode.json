{
  "provider": {
    "lightbridge": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LightBridge",
      "options": {
        "baseURL": "${OPENCODE_BASE_URL}",
        "apiKey": "${OPENCODE_API_KEY}"
      },
      "models": {
        "${OPENCODE_MODEL}": {
          "name": "${OPENCODE_MODEL}"
        }
      }
    }
  },
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": [
        "/usr/local/bin/kubernetes-mcp-server"
      ],
      "enabled": true
    }
  }
}
